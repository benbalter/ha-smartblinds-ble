{
  "domain": "smartblinds_ble",
  "name": "SmartBlinds BLE",
  "bluetooth": [
    {
      "local_name": "RollerSh*",
      "connectable": true
    }
  ],
  "codeowners": ["@benbalter"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/benbalter/ha-smartblinds-ble",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/benbalter/ha-smartblinds-ble/issues",
  "loggers": ["smartblinds_ble"],
  "requirements": ["smartblinds-ble==0.1.0"],
  "version": "0.0.1"
}
